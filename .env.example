# Copy to `.env` (backend) and/or `frontend/.env.local` (frontend) and adjust as needed.
# Never commit real `.env` files.

# --- Backend (FastAPI, read via pydantic-settings, prefix RADARSYNC_) ---
RADARSYNC_ENVIRONMENT=development
# Comma-separated origins allowed to call the API
RADARSYNC_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Frontend (Next.js; NEXT_PUBLIC_* values are inlined at build time) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
